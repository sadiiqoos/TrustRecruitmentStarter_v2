<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TrustRecruitment</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<header style="position: relative; z-index: 9999;">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container-fluid px-4">

            <a class="navbar-brand fw-bold" href="/">
                <span class="text-white">Trust</span><span style="color:#4dabf7;">Recruitment</span>
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarMain"
                    aria-controls="navbarMain"
                    aria-expanded="false"
                    aria-label="Visa meny">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/Jobs">Jobs</a>
                    </li>
                </ul>

                <ul class="navbar-nav align-items-center" style="position: relative; z-index: 9999;">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <span class="navbar-text text-white me-3">
                                Inloggad som @User.Identity.Name
                            </span>
                        </li>

                        <li class="nav-item">
                            <form action="/Account/Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-light">
                                    Logga ut
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/Account/Login">Logga in</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary ms-2 px-3" href="/Account/Signup">Skapa konto</a>
                        </li>
                    }
                </ul>
            </div>

        </div>
    </nav>
</header>

<main class="container py-4" style="position: relative; z-index: 1;">
    @RenderBody()
</main>

<footer class="border-top text-muted py-3 mt-5 bg-white">
    <div class="container text-center">
        &copy; @DateTime.Now.Year - TrustRecruitment
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>