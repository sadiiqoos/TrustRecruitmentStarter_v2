@model IReadOnlyList<JobDto>

<h2>Open jobs</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Title</th>
            <th>Department</th>
            <th>Location</th>
            <th>Type</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var job in Model)
    {
        <tr>
            <td>@job.Title</td>
            <td>@job.Department</td>
            <td>@job.Location, @job.Country</td>
            <td>@job.EmploymentType</td>
            <td>
                <a asp-action="Details" asp-route-id="@job.Id" class="btn btn-sm btn-outline-primary">Details</a>
            </td>
        </tr>
    }
    </tbody>
</table>
