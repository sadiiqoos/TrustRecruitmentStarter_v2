@* Views/Jobs/Details.cshtml *@
@model JobDto

<h2>@Model.Title</h2>

<div class="card">
    <div class="card-body">
        <p><strong>Department:</strong> @Model.Department</p>
        <p><strong>Location:</strong> @Model.Location, @Model.Country</p>
        <p><strong>Employment type:</strong> @Model.EmploymentType</p>
        <p>@Model.Description</p>
        <a asp-controller="Jobs" asp-action="Apply" asp-route-id="@Model.Id" class="btn btn-primary">Apply now</a>
    </div>
</div>